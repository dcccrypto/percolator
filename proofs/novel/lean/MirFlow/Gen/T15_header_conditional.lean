def goal : Goal := ⟨[], [0], [], true⟩

theorem cert : checkCert goal cfg inv = true := by decide +kernel

/-- Checks are numbered: 0 = `self.validate_shape()` returns Ok; k ≥ 1 =
`account_k.validate_with_market(&self.as_view())` returns Ok. -/
theorem main {W : Type} (chk : Nat → W → Bool) {w0 w1 : W} {b : Block} {env1 : Env}
    (hret : Returns chk [] cfg w0 b w1 env1) (hok : env1 0 = 0) :
    (chk 0 w0 = true → chk 0 w1 = true) := by
  have h := checkCert_sound chk cert hret (fun _ => hok)
  exact h.2 0 (by simp [goal])

