/-- Every `Ok` return: checks [] hold, checks [0] are preserved (0 = validate_shape, k = validate_with_market of account k). -/
theorem row {W : Type} (chk : Nat → W → Bool) {w0 w1 : W} {b : Block} {env1 : Env}
