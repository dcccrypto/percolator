  /- bb70 -/ some ⟨[], [⟨[], .chk [] [0]⟩]⟩,
  /- bb71 -/ some ⟨[], [⟨[], .chk [] [0]⟩]⟩,
  /- bb72 -/ some ⟨[], [⟨[], .chk [] [0]⟩]⟩,
  /- bb73 -/ some ⟨[(0, .eq 1)], [⟨[], .chk [] [0]⟩]⟩,
  /- bb74 -/ some ⟨[], [⟨[], .chk [] [0]⟩]⟩,
  /- bb75 -/ some ⟨[], [⟨[], .chk [] [0]⟩]⟩,
  /- bb76 -/ some ⟨[(0, .eq 1)], []⟩,
  /- bb77 -/ some ⟨[(0, .eq 1)], []⟩,
  /- bb78 -/ some ⟨[(0, .eq 1)], [⟨[], .chk [1] [0]⟩]⟩,
  /- bb79 -/ some ⟨[(0, .eq 1)], []⟩,
  /- bb80 -/ some ⟨[(0, .eq 1)], []⟩,
  /- bb81 -/ some ⟨[(0, .eq 1)], [⟨[], .chk [1] [0]⟩]⟩,
  /- bb82 -/ some ⟨[(0, .eq 1)], []⟩,
