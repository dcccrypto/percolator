def goal : Goal := ⟨[⟨[(0, .eq 0)], .chk [1] [0]⟩], [], [0, 1]⟩

theorem cert : checkCert goal cfg inv = true := by decide +kernel

/-- Checks are numbered: 0 = `self.validate_shape()` returns Ok; k ≥ 1 =
`account_k.validate_with_market(&self.as_view())` returns Ok. Local 0 is the return value
(0 = `Ok`), local 1000000 its payload ghost. -/
theorem main {W : Type} (chk : Nat → W → Bool) {w0 w1 : W} {b : Block} {env1 : Env}
    (hret : Returns chk [] cfg w0 b w1 env1) :
    ∀ c, c ∈ goal.cls → Clause.sat chk w0 w1 env1 c :=
  checkCert_sound chk cert hret

/-- Every `Ok` return: checks [1] hold, checks [0] are preserved (0 = validate_shape, k = validate_with_market of account k). -/
theorem row {W : Type} (chk : Nat → W → Bool) {w0 w1 : W} {b : Block} {env1 : Env}
    (hret : Returns chk [] cfg w0 b w1 env1) (h0 : env1 0 = 0) :
    chk 1 w1 = true ∧ (chk 0 w0 = true → chk 0 w1 = true) := by
  have h := main chk hret ⟨[(0, .eq 0)], .chk [1] [0]⟩ (by simp [goal])
  have h2 := h (by intro g hg; simp at hg; rcases hg with rfl <;> first | exact h0)
  exact ⟨h2.1 1 (by simp), h2.2 0 (by simp)⟩

