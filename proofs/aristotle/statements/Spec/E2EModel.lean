module

/-!
# End-to-end value invariants of the v2.2 engine: abstract N-account model

Status: STATEMENTS ONLY. Every theorem below ends in `sorry`. Not typechecked here (no Lean
toolchain on the preparing machine); toolchain pinned in `../lean-toolchain` to match upstream
`proofs/aristotle/statements/lean-toolchain` (leanprover/lean4:v4.34.0). Uses Lean core only
(no Mathlib), so it can be checked standalone with `lean Spec/E2EModel.lean`.

Why this file exists. Kani (CBMC) proves the engine's real entry points end to end only on a
bounded world: one asset, two accounts, u8-sized amounts (tests/proofs_e2e_*.rs on branch
agent/J-20261121-ENG-E2E-PROOFS). It cannot quantify over the number of accounts. The
invariants here are stated for an ARBITRARY list of accounts and arbitrary amounts, over an
abstract state whose steps are exactly the scalar contracts that Kani already proves of the
production kernels over the full u128/i128 domains:

* `feeStep`        = `fee_charge_capital_to_insurance` (body of
                      `charge_account_fee_current_not_atomic`); Kani:
                      tests/proofs_headline_conservation.rs (full domain).
* `settleStep`     = `V16Core::kernel_settle_principal` + the header writes of
                      `settle_negative_pnl_from_principal_core_not_atomic`; Kani:
                      `proof_v16_inductive_settle_negative_pnl_preserves_senior_solvency`
                      (full domain, corrected 2026-11-21, commit c5141a21).
* `markStep`       = the K/F mark-to-market of one matched long/short pair (zero-sum pnl move);
                      Kani: only bounded (tests/proofs_e2e_settle.rs, 1 asset).
* `depositStep`, `withdrawStep` = `deposit_not_atomic` / `withdraw_not_atomic`; Kani: bounded
                      view harnesses in tests/proofs_v16.rs (u8 amounts).
* `insuranceCoverStep` = insurance spent on a bankrupt account's negative pnl
                      (`kernel_consume_insurance_layer`, proved by Aristotle upstream as K12).
* `resolvedCloseStep` = the value movement of `close_resolved_account_not_atomic`
                      (payout = min(capital + claimable, vault)); Kani: bounded
                      tests/proofs_e2e_resolved_close.rs.

What Aristotle should prove (the gap Kani cannot close): Parts A, C, D below for every list
length `n`, every amount, every sequence of steps. The REFINEMENT (each Rust entry point's
compiled body implements its abstract step on the header totals and on the touched account,
and writes no other account) is stated in the prompts (`../prompts/stage_e2e_*.txt`) against
the Rust2Lean vocabulary of upstream `Spec.LayerT` / `Spec.Trade`; it is not in this file
because that vocabulary is generated by Aristotle from the uploaded sources.
-/

@[expose] public section

namespace Spec.E2E

/-! ## State -/

/-- The value fields of one portfolio account (`PortfolioAccountV16Account`). -/
structure Acct where
  capital : Nat
  pnl : Int
deriving Repr, DecidableEq

/-- The value fields of the market header (`MarketGroupV16HeaderAccount`). -/
structure Hdr where
  vault : Nat
  cTot : Nat
  insurance : Nat
deriving Repr, DecidableEq

structure St where
  h : Hdr
  accts : List Acct
deriving Repr

def sumCap : List Acct → Nat
  | [] => 0
  | a :: as => a.capital + sumCap as

def sumPnl : List Acct → Int
  | [] => 0
  | a :: as => a.pnl + sumPnl as

def sumPos : List Acct → Nat
  | [] => 0
  | a :: as => a.pnl.toNat + sumPos as

/-! ## The global invariant (value part) -/

/-- Mirror (part M of upstream's global invariant, value fields only): `c_tot` is the sum of
account capital. -/
def Mirror (s : St) : Prop := s.h.cTot = sumCap s.accts

/-- Senior solvency (spec.md §10 item 1): deposits and insurance are fully backed. -/
def Senior (s : St) : Prop := s.h.cTot + s.h.insurance ≤ s.h.vault

/-- The "booked equity" of the system: capital + pnl (signed) + insurance. -/
def bookedEquity (s : St) : Int := (sumCap s.accts : Int) + sumPnl s.accts + s.h.insurance

/-- Value conservation as a single number: vault minus booked equity. Every value-moving step
except external flows (deposit, withdraw, payout) and explicit bad-debt write-offs leaves it
unchanged. -/
def slack (s : St) : Int := (s.h.vault : Int) - bookedEquity s

/-! ## Steps (each is the scalar contract of a production kernel; see the header) -/

def setAt (as : List Acct) (i : Nat) (a : Acct) : List Acct := as.set i a

def getD (as : List Acct) (i : Nat) : Acct := as.getD i ⟨0, 0⟩

/-- `fee_charge_capital_to_insurance`: `charged = 0` if `fee = 0` or `pnl < 0`, else
`min fee capital`; capital and `c_tot` drop by it, insurance rises by it. -/
def feeStep (s : St) (i fee : Nat) : St :=
  let a := getD s.accts i
  let charged := if fee = 0 ∨ a.pnl < 0 then 0 else min fee a.capital
  { h := { s.h with cTot := s.h.cTot - charged, insurance := s.h.insurance + charged }
    accts := setAt s.accts i { a with capital := a.capital - charged } }

/-- `kernel_settle_principal`: on `pnl < 0`, `paid = min capital |pnl|` moves from capital (and
`c_tot`) into pnl. Vault and insurance untouched. -/
def settleStep (s : St) (i : Nat) : St :=
  let a := getD s.accts i
  if a.pnl < 0 then
    let paid := min a.capital a.pnl.natAbs
    { h := { s.h with cTot := s.h.cTot - paid }
      accts := setAt s.accts i { capital := a.capital - paid, pnl := a.pnl + paid } }
  else s

/-- Mark-to-market of a matched pair: the long gains `d`, the short loses `d` (signed `d`). -/
def markStep (s : St) (l sh : Nat) (d : Int) : St :=
  let al := getD s.accts l
  let s1 : St := { s with accts := setAt s.accts l { al with pnl := al.pnl + d } }
  let as := getD s1.accts sh
  { s1 with accts := setAt s1.accts sh { as with pnl := as.pnl - d } }

def depositStep (s : St) (i amt : Nat) : St :=
  let a := getD s.accts i
  { h := { s.h with vault := s.h.vault + amt, cTot := s.h.cTot + amt }
    accts := setAt s.accts i { a with capital := a.capital + amt } }

/-- Withdraw `amt ≤ capital` (the engine refuses more; the margin gate is not modelled). -/
def withdrawStep (s : St) (i amt : Nat) : St :=
  let a := getD s.accts i
  { h := { s.h with vault := s.h.vault - amt, cTot := s.h.cTot - amt }
    accts := setAt s.accts i { a with capital := a.capital - amt } }

/-- Insurance spent on a negative pnl: `x = min insurance |pnl|`. -/
def insuranceCoverStep (s : St) (i : Nat) : St :=
  let a := getD s.accts i
  if a.pnl < 0 then
    let x := min s.h.insurance a.pnl.natAbs
    { h := { s.h with insurance := s.h.insurance - x }
      accts := setAt s.accts i { a with pnl := a.pnl + x } }
  else s

/-- Resolved close of a flat, settled account (`pnl ≥ 0` after settlement) with `claimable`
the receipt's claimable amount: `payout = min (capital + claimable) vault`; vault drops by the
payout, `c_tot` by the capital; the account is zeroed. -/
def resolvedCloseStep (s : St) (i claimable : Nat) : St × Nat :=
  let a := getD s.accts i
  let payout := min (a.capital + claimable) s.h.vault
  ({ h := { s.h with vault := s.h.vault - payout, cTot := s.h.cTot - a.capital }
     accts := setAt s.accts i ⟨0, 0⟩ }, payout)

/-! ## Part A: value conservation for arbitrary N (the gap: Kani proves it for N = 2 only) -/

theorem A1_fee_conserves (s : St) (i fee : Nat) (hi : i < s.accts.length) (hm : Mirror s) :
    Mirror (feeStep s i fee) ∧ slack (feeStep s i fee) = slack s := by
  sorry

theorem A2_settle_conserves (s : St) (i : Nat) (hi : i < s.accts.length) (hm : Mirror s) :
    Mirror (settleStep s i) ∧ slack (settleStep s i) = slack s := by
  sorry

theorem A3_mark_conserves (s : St) (l sh : Nat) (d : Int) (hl : l < s.accts.length)
    (hs : sh < s.accts.length) (hne : l ≠ sh) :
    sumCap (markStep s l sh d).accts = sumCap s.accts ∧ slack (markStep s l sh d) = slack s := by
  sorry

theorem A4_deposit_external (s : St) (i amt : Nat) (hi : i < s.accts.length) (hm : Mirror s) :
    Mirror (depositStep s i amt) ∧ slack (depositStep s i amt) = slack s := by
  sorry

theorem A5_withdraw_external (s : St) (i amt : Nat) (hi : i < s.accts.length) (hm : Mirror s)
    (hamt : amt ≤ (getD s.accts i).capital) (hv : amt ≤ s.h.vault) :
    Mirror (withdrawStep s i amt) ∧ slack (withdrawStep s i amt) = slack s := by
  sorry

theorem A6_insurance_cover_conserves (s : St) (i : Nat) (hi : i < s.accts.length) :
    slack (insuranceCoverStep s i) = slack s := by
  sorry

/-- Any finite sequence of the conserving steps preserves `Mirror` and `slack` exactly. -/
inductive Step : St → St → Prop
  | fee (s : St) (i fee : Nat) : i < s.accts.length → Step s (feeStep s i fee)
  | settle (s : St) (i : Nat) : i < s.accts.length → Step s (settleStep s i)
  | mark (s : St) (l sh : Nat) (d : Int) :
      l < s.accts.length → sh < s.accts.length → l ≠ sh → Step s (markStep s l sh d)
  | deposit (s : St) (i amt : Nat) : i < s.accts.length → Step s (depositStep s i amt)
  | withdraw (s : St) (i amt : Nat) : i < s.accts.length →
      amt ≤ (getD s.accts i).capital → amt ≤ s.h.vault → Step s (withdrawStep s i amt)
  | cover (s : St) (i : Nat) : i < s.accts.length → Step s (insuranceCoverStep s i)

inductive Steps : St → St → Prop
  | refl (s : St) : Steps s s
  | cons (s t u : St) : Step s t → Steps t u → Steps s u

theorem A7_sequence_conserves (s t : St) (hm : Mirror s) (h : Steps s t) :
    Mirror t ∧ slack t = slack s ∧ t.accts.length = s.accts.length := by
  sorry

/-! ## Part C: senior solvency for arbitrary N -/

theorem C1_step_preserves_senior (s t : St) (hm : Mirror s) (hs : Senior s) (h : Step s t) :
    Senior t := by
  sorry

theorem C2_reachable_senior (s t : St) (hm : Mirror s) (hs : Senior s) (h : Steps s t) :
    Mirror t ∧ Senior t := by
  sorry

/-! ## Part D: resolved close pays exactly what is owed, for arbitrary N and any close order

Model of the payout snapshot: after resolution and after every loser is settled
(`pnl ≤ 0` accounts have `pnl = 0`, their loss already moved by `settleStep` /
`insuranceCoverStep`), the residual `R = vault - c_tot - insurance` backs the positive claims
`P = sumPos`. Each winner's claimable amount is `pos * R / P` (floor) when `R < P`, else `pos`
(full). Upstream records order-dependence cases BEFORE the snapshot (engine issues #132/#175);
these statements are about closes AFTER the snapshot only. -/

def claimable (R P pos : Nat) : Nat := if P ≤ R then pos else pos * R / P

/-- Close the accounts with indices `order` in sequence; returns final state and total paid. -/
def closeAll (s : St) (R P : Nat) : List Nat → St × Nat
  | [] => (s, 0)
  | i :: is =>
    let a := getD s.accts i
    let (s1, p) := resolvedCloseStep s i (claimable R P a.pnl.toNat)
    let (s2, q) := closeAll s1 R P is
    (s2, p + q)

/-- Each close pays the account exactly `capital + claimable` (never capped by the vault). -/
theorem D1_each_close_exact (s : St) (i R P : Nat) (hm : Mirror s) (hs : Senior s)
    (hsettled : ∀ a ∈ s.accts, 0 ≤ a.pnl)
    (hR : s.h.vault - s.h.cTot - s.h.insurance = R) (hP : sumPos s.accts = P)
    (hi : i < s.accts.length) :
    (resolvedCloseStep s i (claimable R P (getD s.accts i).pnl.toNat)).2 =
      (getD s.accts i).capital + claimable R P (getD s.accts i).pnl.toNat := by
  sorry

/-- Closing every account (any permutation of the indices) pays out exactly
`sumCap + Σ claimable`, independent of the order, and never more than the vault. What is left
in the vault is the insurance plus the unpaid residual `R - Σ claimable`; when the residual is
short of the claims (`R < P`) that leftover is floor-rounding dust, fewer atoms than there are
accounts; when it is not, every winner was paid in full. `c_tot` ends at 0. -/
theorem D2_close_all_exact_and_order_independent (s : St) (order : List Nat)
    (hm : Mirror s) (hs : Senior s) (hsettled : ∀ a ∈ s.accts, 0 ≤ a.pnl)
    (hperm : order.Perm (List.range s.accts.length))
    (R P : Nat) (hR : s.h.vault - s.h.cTot - s.h.insurance = R) (hP : sumPos s.accts = P) :
    let claims := (s.accts.map (fun a => claimable R P a.pnl.toNat)).foldr (· + ·) 0
    let r := closeAll s R P order
    r.2 = sumCap s.accts + claims ∧
    r.2 ≤ s.h.vault ∧
    claims ≤ R ∧
    r.1.h.vault = s.h.insurance + (R - claims) ∧
    (R < P → R - claims < s.accts.length) ∧
    (P ≤ R → claims = P) ∧
    r.1.h.cTot = 0 := by
  sorry

end Spec.E2E
